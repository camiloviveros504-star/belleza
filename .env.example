# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Endpoint que recibe los formularios en JSON (p. ej. https://formspree.io/f/xxxxxxx).
# Si lo dejas vacío, el formulario funciona en "modo demostración" y no envía nada.
VITE_FORM_ENDPOINT=
# Opcional: endpoint distinto para el boletín. Si está vacío se usa VITE_FORM_ENDPOINT.
VITE_NEWSLETTER_ENDPOINT=

# Opcionales. Solo se cargan si la persona acepta la categoría de cookies correspondiente.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
